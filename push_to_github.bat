@echo off
chcp 65001 > nul
echo ========================================================
echo   در حال ارسال (Push) به گیت‌هاب: rbshop
echo ========================================================
cd /d "%~dp0"
git push -u origin main
if %errorlevel% neq 0 (
    echo.
    echo در صورت وجود فایل اولیه در گیت‌هاب، ارسال اجباری (force) انجام می‌شود...
    git push -u origin main --force
)
echo.
echo ========================================================
echo   ارسال با موفقیت انجام شد!
echo ========================================================
pause
